[configuration]

entry_symbol = "quantum_matrix_library_init"
compatibility_minimum = "4.1"

[libraries]

; NOTE: ConfigFile comments MUST use ';' — a '#' line is NOT a comment: its text
; gets glued into the next key, silently mangling the first entry of the block.
; (That bug hid the web entry from the exporter for a full release cycle.)

; Linux (native — built and working)
linux.x86_64 = "res://native/bin/linux/libquantummatrix.linux.template_release.x86_64.so"
linux.debug.x86_64 = "res://native/bin/linux/libquantummatrix.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://native/bin/linux/libquantummatrix.linux.template_release.x86_64.so"

; Windows (cross-compiled from Linux with MinGW, required for shipping)
windows.x86_64 = "res://native/bin/windows/libquantummatrix.windows.template_release.x86_64.dll"
windows.debug.x86_64 = "res://native/bin/windows/libquantummatrix.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/bin/windows/libquantummatrix.windows.template_release.x86_64.dll"

; Web/WASM. The export preset ships the THREADS engine variant
; (variant/thread_support=true), and since Godot 4.3 web GDExtension entries
; must name the variant explicitly — a bare web.wasm32 key is rejected at load
; so a nothreads lib can never link into a shared-memory engine (or vice versa).
; The lib is compiled with -pthread to match (scripts/build-all-platforms.sh).
web.threads.wasm32 = "res://native/bin/web/libquantummatrix.wasm"

; macOS (optional)
; macos.debug = "res://native/bin/macos/libquantummatrix.macos.template_debug.framework"
; macos.release = "res://native/bin/macos/libquantummatrix.macos.template_release.framework"
