# Godot project files
.godot/
*.translation

# LLM working directories (not source code)
llm_inbox/
llm_outbox/

# Archive directories (deprecated code)
Archive/
archive/

# Test workspace (large local scratch area)
Tests/
!Tests/rig_listener.gd

# Editor-specific files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build and export
bin/
build/
export/
exports/
releases/
*.exe
*.dll
*.so
*.dylib
*.a
*.o
*.obj
*.lib
*.pdb

# Native build artifacts
native/bin/
native/lib/*.a
native/lib/*.so
native/src/*.o
native/src/*.obj
native_OLD_BLOATED_*/
*.gd.backup
*.gd.old
*.gd.old_v1

# User-specific
*.cfg
!export_presets.cfg  # Need this for building on other machines
user_settings/
local_settings.json

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Temporary files
*.tmp
*.tmp.*
*.gd.tmp.*
*.bak
*.log
logs/

# WSL artifacts
*Zone.Identifier

# Test outputs
test_results/
player_logs/
llm_inbox/player_logs/

# Godot shader cache (auto-generated)
.godot/shader_cache/

# Keep tracked: Source code, scenes, and documentation
# Do not ignore:
# - project.godot
# - .gd files
# - .tscn files
# - .tres files
# - .md files
# - .sh files
# - .py files (except __pycache__)
build_web/

# 🍄 runtime artifacts (ignore by default)
🍄/logs/
🍄/🎛️/logs/
🍄/🎛️/🧾/
🍄/🎛️/.godot/
🍄/🎛️/.godot_tmp/
🍄/🎛️/.godot_tmp2/
🍄/🎛️/__pycache__/
🍄/🎛️/dev/__pycache__/

# 🍄 curated artifacts explicitly kept in git
!🍄/artifacts_whitelist/
!🍄/artifacts_whitelist/**
